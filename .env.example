# ===== ضروری =====

# توکن ربات از BotFather
BOT_TOKEN=

# آدرس عمومی سرور، مثل https://landogifts.shop (بدون اسلش آخر)
PUBLIC_URL=

# یک رشته دلخواه و رندوم برای امنیت وبهوک
WEBHOOK_SECRET=change-me

PORT=3000

# آیدی عددی ادمین‌ها (با کاما جدا کن) - همان‌هایی که دکمه‌های تایید/رد رو تو تلگرام می‌بینن
ADMIN_IDS=

# رمز ورود پنل ادمین تحت وب (admin/index.html)
ADMIN_PANEL_PASSWORD=change-me

# ===== اختیاری =====

# یوزرنیم کانال بدون @ - اگه ست بشه، عضویت اجباری میشه
REQUIRED_CHANNEL=

# یوزرنیم پشتیبانی بدون @ (قابل تغییر از پنل ادمین هم هست)
SUPPORT_USERNAME=

# درصد پورسانت معرف از خرید زیرمجموعه
REFERRAL_PERCENT=5

# کارمزد پلتفرم روی بازار گیفت (امانی)
GIFT_MARKET_FEE_PERCENT=5

# کارمزد تبدیل بین تومان و ارز دیجیتال (قابل تغییر از پنل ادمین هم هست)
SWAP_FEE_PERCENT=1

# شماره کارت مقصد که تو مینی‌اپ برای شارژ کارت‌به‌کارت نشون داده میشه
ADMIN_CARD_NUMBER=
ADMIN_CARD_OWNER=
