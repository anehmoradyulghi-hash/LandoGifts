# ===== Required =====
BOT_TOKEN=                     # Bot token from BotFather
PUBLIC_URL=                    # Public server address, e.g. https://yourapp.up.railway.app
WEBHOOK_SECRET=change-me       # A random string of your choice, for webhook security
PORT=3000

# PostgreSQL connection string, e.g. postgres://user:password@localhost:5432/lando_gifts
DATABASE_URL=
# Set to "true" only if your Postgres provider requires SSL (most managed hosts do)
PGSSL=false

# Redis connection string, e.g. redis://127.0.0.1:6379 (used for admin panel sessions)
REDIS_URL=redis://127.0.0.1:6379

# Numeric admin IDs (comma-separated) — the ones who see the approve/reject buttons in Telegram
ADMIN_IDS=

# Login password for the web admin panel (admin/index.html)
ADMIN_PANEL_PASSWORD=change-me

# ===== Optional =====
REQUIRED_CHANNEL=              # Channel username without @ — if set, membership becomes mandatory
COMMUNITY_CHANNEL=
COMMUNITY_CHAT=

REFERRAL_PERCENT=5             # Referral commission percent from a referral's purchase (fallback default — configurable from the admin panel)
GIFT_MARKET_FEE_PERCENT=5      # Platform fee on the gift market (consignment)
SWAP_FEE_PERCENT=1             # Fee for converting between LNDC and a digital currency

# Destination card number shown in the mini app for card-to-card top-ups
ADMIN_CARD_NUMBER=
ADMIN_CARD_OWNER=
